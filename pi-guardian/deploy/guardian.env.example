# Copy to /etc/mimo-guardian/guardian.env ON THE DEVICE ONLY. Never commit this file with real
# values -- it is not meant to live in this repository at all once filled in.
# After creating it on the device: chmod 600 /etc/mimo-guardian/guardian.env

# Production backend host (no scheme, no path -- see pi-guardian/guardian/publisher.py).
GUARDIAN_API_HOST=api-upqxuj7evq-uc.a.run.app

# This kiosk's derived per-kiosk signing key, 64 hex characters (32 bytes). NEVER the Guardian
# master key -- compute this once per kiosk from the master key using the helper documented in
# README.md, then discard the master key from wherever you ran that computation.
GUARDIAN_DERIVED_KEY_HEX=

# Must match the activeKeyVersion this kiosk was provisioned with in the guardian_kiosks registry.
GUARDIAN_KEY_VERSION=1
