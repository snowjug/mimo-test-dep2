rules_version = '2';
// IMPORTANT, read before changing: this app has NO Firebase Auth session anywhere (confirmed — neither the
// customer website nor the admin dashboard ever calls signInWithCustomToken/signInWithEmailAndPassword/etc).
// request.auth is therefore always null for every real request this app makes, so a rule like
// "allow write: if request.auth != null" would reject 100% of legitimate uploads, not just attackers.
//
// WRITE and, for /uploads, READ (audit finding F-01, fixed): the client Storage SDK is no longer used to
// read or write /uploads/** at all. Both now go through backend endpoints -- POST /upload-url (write) and
// POST /read-url (read), or POST /admin/upload-url for the admin dashboard's own uploads -- that mint a
// short-lived V4 signed URL scoped to exactly one object, after the backend verifies the caller's identity
// via its own JWT auth and (for reads) that the object path belongs to them. See
// functions/src/controllers/upload.controller.js's postGetUploadUrl/postGetReadUrl and admin.controller.js's
// postGetAdminUploadUrl. Signed URLs are issued and verified by Cloud Storage's own IAM-based signing
// mechanism (storage.googleapis.com), which is a DIFFERENT code path from these Firebase security rules
// (which only govern the Firebase client SDK / firebasestorage.googleapis.com) -- `read: if false` and
// `write: if false` below only block direct, unsigned access; they do not affect the signed-URL flow at all.
//
// profiles/screensaver/templates/ads stay read: true -- deliberately, not an oversight. These are lower
// sensitivity than a customer's own uploaded print document (an avatar, a kiosk marketing video, a shared
// blank-sheet template, an ad banner) and several existing frontend flows display them by their plain URL.
// Only /uploads holds potentially-sensitive customer documents, so it's the one path this migration
// actually needed to close for read, not the others.
service firebase.storage {
  match /b/{bucket}/o {
    match /uploads/{allPaths=**} { allow read: if false; allow write: if false; }
    match /profiles/{allPaths=**} { allow read: if true; allow write: if false; }
    match /screensaver/{allPaths=**} { allow read: if true; allow write: if false; }
    match /templates/{allPaths=**} { allow read: if true; allow write: if false; }
    // Ads are written ONLY server-side (ads.controller.js's postAdminAdImage, via the Admin SDK, which
    // already bypasses these rules entirely) -- never directly from a browser, unlike the paths above.
    // So this only needs read, not write: granting write here would let anyone write arbitrary files to
    // this path directly via the client Storage SDK, bypassing the backend's MIME-type/size validation.
    // Read must be public: the customer-facing AdBanner loads these images unauthenticated.
    match /ads/{allPaths=**} { allow read: if true; allow write: if false; }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
