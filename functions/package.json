    "bcryptjs": "^3.0.3",
    "busboy": "^1.6.0",
    "cashfree-pg": "^6.0.4",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.2.5",
    "google-auth-library": "^10.6.2",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^8.0.9",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.20.2",
    "uuid": "^11.1.1"
  },
