# Copy to pi-hosts.env (git-ignored) and fill in. Real values are in the shared credentials file, never in git.
# Use PASSWORD *or* KEY_FILE for each Pi. SUDO_PASSWORD defaults to PASSWORD.

# MIMO 1.0 — kiosk CV-001 (hostname printpi)
PI_CV001_HOST=
PI_CV001_USER=printpi
PI_CV001_PASSWORD=
# PI_CV001_KEY_FILE=~/.ssh/id_ed25519
# PI_CV001_SUDO_PASSWORD=
# PI_CV001_LAN_HOST=

# MIMO 2.0 — kiosk SV-002 (hostname pi)
PI_SV002_HOST=
PI_SV002_USER=pi
PI_SV002_PASSWORD=
# PI_SV002_KEY_FILE=~/.ssh/id_ed25519
# PI_SV002_SUDO_PASSWORD=
# LAN address of SV-002, used by deploy_all_fixes.py to hop CV-001 -> SV-002
PI_SV002_LAN_HOST=

# Set to 1 to trust unknown SSH host keys automatically (default: warn)
# PI_ACCEPT_NEW_HOST_KEYS=1
