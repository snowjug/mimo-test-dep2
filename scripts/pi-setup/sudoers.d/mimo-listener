# /etc/sudoers.d/mimo-listener
# Narrow, least-privilege sudo configuration for the MIMO Print Listener service.
# Installed on:
#   - CV-001 (Raspberry Pi 5, user: printpi)
#   - SV-002 (Raspberry Pi 4, user: pi)
#
# IMPORTANT SECURITY CONSTRAINTS:
# 1. Never grant unrestricted 'NOPASSWD: ALL'.
# 2. Only the exact commands required for automated CUPS healing, USB sleep recovery,
#    service maintenance, and remote reboot are permitted.
# 3. Arguments are restricted to safe, non-interactive executables.

# 1. CUPS Queue Management (re-enabling paused/stuck queues after error clearance)
Cmnd_Alias MIMO_CUPS = /usr/sbin/cupsenable, /usr/sbin/cupsaccept, \
                       /usr/bin/cupsenable, /usr/bin/cupsaccept

# 2. Hardware USB Reset (waking sleeping Brother/Epson printers over USB)
Cmnd_Alias MIMO_USB = /usr/bin/usbreset

# 3. Systemd Service Control (CUPS daemon restart and disabling conflicting ipp-usb daemon)
Cmnd_Alias MIMO_SYSTEMD = /bin/systemctl restart cups, /usr/bin/systemctl restart cups, \
                          /bin/systemctl stop ipp-usb, /usr/bin/systemctl stop ipp-usb, \
                          /bin/systemctl disable ipp-usb, /usr/bin/systemctl disable ipp-usb

# 4. Kiosk Remote Reboot (safe watchdog / backend remote restart)
Cmnd_Alias MIMO_REBOOT = /sbin/reboot, /usr/sbin/reboot

# User permissions: grant only the specific aliases non-interactively
printpi ALL=(ALL) NOPASSWD: MIMO_CUPS, MIMO_USB, MIMO_SYSTEMD, MIMO_REBOOT
pi ALL=(ALL) NOPASSWD: MIMO_CUPS, MIMO_USB, MIMO_SYSTEMD, MIMO_REBOOT
